{
  "_comment": "将此配置合并到 ~/.claude/settings.json 的 hooks 字段中。使用 Claude Code 原生 http hook 类型，无需依赖 curl。",

  "SessionStart": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/green",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/working",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],
  "PreToolUse": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/working",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/working",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],
  "PermissionRequest": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/waiting",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/done",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:17323/api/done",
          "timeout": 2
        }
      ],
      "matcher": ""
    }
  ],

  "_notes": {
    "hook类型": "使用 Claude Code 内置的 'http' 类型 hook，无需 curl/PowerShell，纯配置即可",
    "事件说明": {
      "SessionStart": "会话启动 → 绿色就绪",
      "UserPromptSubmit": "用户发送消息 → 蓝色工作中",
      "PreToolUse": "工具开始执行 → 蓝色工作中",
      "PostToolUse": "工具执行完毕 → 蓝色工作中（可能继续下一步）",
      "PermissionRequest": "请求权限 → 红色等待确认",
      "Stop": "响应结束 → 绿色就绪",
      "SessionEnd": "会话结束 → 绿色就绪"
    },
    "端口": "status_monitor.py 内嵌服务器监听 17323；如用 status_server.py 独立版则改为 17322",
    "Windows注意": "如使用独立 status_server.py，需先启动它再启动 Claude Code"
  }
}
